# Set to true only when serving the app over HTTPS.
COOKIE_SECURE=false

# Optional: host and port for the JavaScript backend.
# AUTOCARE_HOST=127.0.0.1
# AUTOCARE_PORT=8000

# Comma-separated exact browser origins allowed to call the local API.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Optional: database path. Defaults to ./autocare.sqlite3.
# AUTOCARE_DB_PATH=C:\path\to\autocare.sqlite3
